# This file was created to store environment variables for local development.
# Copy this file to .env and adjust the values.
# Do not commit .env to Git.

CI_ENVIRONMENT=development
app.baseURL='http://localhost:8080/'
app.indexPage=''

# Database
database.default.hostname=localhost
database.default.database=sasya_db
database.default.username=root
database.default.password=
database.default.DBDriver=MySQLi
database.default.DBPrefix=
database.default.port=3306

# Security
encryption.key=CHANGE_ME_WITH_A_SECURE_RANDOM_KEY
session.cookieName=sasya_session
session.expiration=7200
session.savePath=WRITEPATH.'session/'

# App
app.timezone=Asia/Jakarta
app.locale=id
app.needsEncryption=true

# Payment (sandbox settings)
payment.qris.provider=sandbox
payment.qris.mode=sandbox
payment.qris.merchant_id=merchant_demo
payment.qris.api_key=demo_api_key
payment.qris.secret_key=demo_secret_key
payment.qris.webhook_secret=demo_webhook_secret
payment.qris.endpoint_url=https://sandbox.example-provider.com/api

# Logging
default.systemLogWriter=file

{
  "name": "sasya-class-management",
  "description": "SASYA Class Management System built on CodeIgniter 4",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "codeigniter4/framework": "^4.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php spark --help >/dev/null 2>&1 || true"
    ]
  }
}
